<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>io.github.chansan.example</groupId>
  <artifactId>example</artifactId>
  <version>0.1.0-jdk8-SNAPSHOT</version>
  <name>Example</name>
  <description>模拟独立业务工程接入 FileBridge Starter</description>

  <properties>
    <java.version>8</java.version>
    <file-bridge.version>0.1.0-jdk8-SNAPSHOT</file-bridge.version>
  </properties>

  <dependencies>
    <!-- FileBridge 对外接入入口；示例只依赖 Starter，不直接依赖内部实现模块。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-spring-boot-starter</artifactId>
      <version>${file-bridge.version}</version>
    </dependency>
    <!-- 提供 Spring MVC、嵌入式 Web 容器和 JSON HTTP 支持，用于演示 REST 接口。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 提供 Jakarta Bean Validation，用于校验 REST 请求参数。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Spring Boot 2.7 使用 Flyway Core 自动执行数据库迁移。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- MySQL JDBC 驱动，仅在示例运行时连接数据库。 -->
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 将独立示例打包为可运行 Spring Boot JAR，并提供 spring-boot:run。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
