<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chansan</groupId>
    <artifactId>file-bridge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>file-bridge-persistence-jdbc</artifactId>
  <name>file-bridge-persistence-jdbc</name>
  <dependencies>
    <!-- 复用核心领域模型、仓储接口和事务扩展端口。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供 NamedParameterJdbcTemplate、事务模板及 JDBC 异常体系。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <!-- JUnit 5 测试框架，仅用于当前模块测试。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 提供流式断言 API，提高测试断言的可读性。 -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 将 Testcontainers 生命周期接入 JUnit 5。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 测试时启动真实 MySQL 容器，验证生产数据库语义。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 测试代码连接 Testcontainers MySQL 所需的 JDBC 驱动。 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 测试前执行数据库迁移，确保仓储测试基于真实表结构。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 为测试中的 Flyway 提供 MySQL 方言支持。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
