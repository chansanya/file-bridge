<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.chansan</groupId>
  <artifactId>file-bridge-parent</artifactId>
  <version>0.1.0-jdk8-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FileBridge</name>
  <description>Spring Boot 可集成的通用文件服务组件</description>
  <url>https://github.com/chansanya/file-bridge</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>file-bridge-core</module>
    <module>file-bridge-storage-local</module>
    <module>file-bridge-upload</module>
    <module>file-bridge-persistence-jdbc</module>
    <module>file-bridge-storage-minio</module>
    <module>file-bridge-storage-aliyun</module>
    <module>file-bridge-storage-tencent</module>
    <module>file-bridge-spring-boot-autoconfigure</module>
    <module>file-bridge-spring-boot-starter</module>
    <module>example</module>
  </modules>

  <properties>
    <java.version>8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring-boot.version>2.7.18</spring-boot.version>
    <minio.version>9.0.3</minio.version>
    <aliyun-oss.version>3.18.5</aliyun-oss.version>
    <tencent-cos.version>5.6.279</tencent-cos.version>
    <httpclient4.version>4.5.14</httpclient4.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 导入 Spring Boot BOM，统一 Spring、测试、数据库和常用三方库版本。 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 统一管理 MinIO Java SDK 版本，具体依赖只在 MinIO 适配模块中引入。 -->
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>
      <!-- 统一管理阿里云 OSS Java SDK 版本，避免各模块自行声明版本。 -->
      <dependency>
        <groupId>com.aliyun.oss</groupId>
        <artifactId>aliyun-sdk-oss</artifactId>
        <version>${aliyun-oss.version}</version>
      </dependency>
      <!-- 统一管理腾讯云 COS Java SDK 版本。 -->
      <dependency>
        <groupId>com.qcloud</groupId>
        <artifactId>cos_api</artifactId>
        <version>${tencent-cos.version}</version>
      </dependency>
      <!-- 统一 Apache HttpClient 4 版本，解决阿里云 SDK 传递依赖的版本收敛冲突。 -->
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>${httpclient4.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 统一 Java 编译插件版本，并固定 Java 8 字节码与参数名保留策略。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
          <configuration>
            <!-- 生成 Java 8 字节码，并只使用 Java 8 语言级别。 -->
            <source>${java.version}</source>
            <target>${java.version}</target>
            <!-- 将方法参数名写入字节码，便于 Spring 反射绑定和诊断。 -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <!-- 运行 *Test 单元测试，并在 test 阶段生成测试报告。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <!-- 预留 *IT 集成测试插件版本；模块启用后在 integration-test/verify 阶段执行。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <!-- 校验 Java、Maven 版本以及传递依赖是否收敛。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 在构建早期阻止错误 JDK、Maven 或依赖版本冲突进入后续阶段。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <!-- 执行下方 rules 中声明的全部约束。 -->
              <goal>enforce</goal>
            </goals>
            <!-- validate 阶段最先执行环境和依赖约束检查。 -->
            <phase>validate</phase>
            <configuration>
              <!-- rules 中的全部规则必须同时通过。 -->
              <rules>
                <!-- 校验执行 Maven 的 JDK 版本。 -->
                <requireJavaVersion>
                  <!-- [1.8,) 表示 Java 版本必须大于或等于 8。 -->
                  <version>[1.8,)</version>
                </requireJavaVersion>
                <!-- 校验 Maven Wrapper 或本机 Maven 版本。 -->
                <requireMavenVersion>
                  <!-- [3.6.3,) 表示 Maven 版本必须大于或等于 3.6.3。 -->
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
                <!-- 要求同一依赖只能解析为一个版本，避免运行期类冲突。 -->
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
