<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chansan</groupId>
    <artifactId>file-bridge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>file-bridge-spring-boot-autoconfigure</artifactId>
  <name>file-bridge-spring-boot-autoconfigure</name>
  <dependencies>
    <!-- 自动配置需要装配的核心模型、SPI 和服务接口。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供普通上传、分片、清理和对账等默认业务实现。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-upload</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供默认可用的本地存储实现和存储注册表。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-storage-local</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供基于 Spring JDBC 的仓储和事务实现。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-persistence-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 仅用于编译期识别 MinIO 适配器；optional 防止 Starter 强制传递云 SDK。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-storage-minio</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- 仅用于编译期识别阿里云 OSS 适配器；optional 防止强制传递云 SDK。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-storage-aliyun</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- 仅用于编译期识别腾讯云 COS 适配器；optional 防止强制传递云 SDK。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-storage-tencent</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- 提供 @AutoConfiguration、条件装配和配置属性绑定基础设施。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- 编译时生成配置元数据，供 IDE 补全和校验 file-bridge.* 属性。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 声明配置和扩展参数校验所需的 Jakarta Validation API。 -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
  </dependencies>
</project>
