<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chansan</groupId>
    <artifactId>file-bridge-parent</artifactId>
    <version>0.1.0-jdk8-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>file-bridge-storage-minio</artifactId>
  <name>file-bridge-storage-minio</name>
  <dependencies>
    <!-- 实现核心存储 SPI，并复用统一模型和异常。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- MinIO 官方 Java SDK，用于对象、签名 URL 和原生分片操作。 -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>
    <!-- 补充 MinIO SDK 在 Maven 下需要的 JVM 版 OkHttp 实现。 -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>5.3.2</version>
    </dependency>
    <!-- JUnit 5 存储契约测试。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 流式断言存储结果。 -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 5 管理 MinIO 容器生命周期。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 提供 GenericContainer 运行真实 MinIO。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
