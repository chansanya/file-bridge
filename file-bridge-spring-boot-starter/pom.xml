<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chansan</groupId>
    <artifactId>file-bridge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>file-bridge-spring-boot-starter</artifactId>
  <name>file-bridge-spring-boot-starter</name>
  <dependencies>
    <!-- 引入 FileBridge 自动配置，是 Starter 的核心功能入口。 -->
    <dependency>
      <groupId>io.github.chansan</groupId>
      <artifactId>file-bridge-spring-boot-autoconfigure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 提供 Spring Boot 基础运行环境、日志和自动配置基础依赖。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- 提供 DataSource、JDBC 和事务自动配置，支撑 JDBC 持久化实现。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
  </dependencies>
</project>
